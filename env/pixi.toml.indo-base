[workspace]
channels = ["conda-forge", "bioconda"]
name = "vvg-box"
platforms = ["osx-arm64"]
version = "0.1.0"

[tasks]

[dependencies]
python = "3.12.*"
pip = ">=26.1.2,<27"
tomlkit = ">=0.15.0,<0.16"
snakemake = ">=9.20"
snakemake-executor-plugin-cluster-generic = ">=1.0.9,<2"
r-base = "4.5.*"
r-tidyverse = ">=2.0.0,<3"
r-readxl = ">=1.5.0,<2"
r-janitor = ">=2.2.1,<3"
"r-data.table" = ">=1.17.8,<2"
r-gridextra = ">=2.3,<3"
r-pheatmap = ">=1.0.13,<2"
r-viridis = ">=0.6.5,<0.7"
r-biocmanager = ">=1.30.27,<2"
r-ape = ">=5.8_1,<6"
r-sf = ">=1.1_0,<2"
r-rnaturalearth = ">=1.2.0,<2"
r-rnaturalearthdata = ">=1.0.0,<2"
r-maps = ">=3.4.3,<4"
r-igraph = ">=2.3.2,<3"
r-tidygraph = ">=1.3.0,<2"
r-graphlayouts = ">=1.2.3,<2"
r-ggraph = ">=2.2.2,<3"
r-cowplot = ">=1.2.0,<2"
r-patchwork = ">=1.3.2,<2"
r-ggrepel = ">=0.9.8,<0.10"
r-ggforce = ">=0.5.0,<0.6"
r-ggbreak = ">=0.1.7,<0.2"
r-nloptr = ">=2.2.1,<3"
r-lme4 = ">=2.0_1,<3"
r-mice = ">=3.19.0,<4"
r-svglite = ">=2.2.2,<3"
